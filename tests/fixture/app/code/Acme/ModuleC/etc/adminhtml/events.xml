<?xml version="1.0"?>
<!--
  Multi-area collapse regression fixture (verify-wiring live pps run,
  2026-07-31): the SAME observer class can be registered on the SAME event in
  MULTIPLE areas -- real core example: Magento\Csp\Observer\Render is
  registered in both etc/events.xml (global) and
  etc/adminhtml/events.xml. This file duplicates ModuleB's
  etc/frontend/events.xml "checkout_cart_save_after" -> FooPlugin
  registration, scoped to adminhtml instead -- exercising the per-area edge
  identity fix (mappers/area-ordinal.ts).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_save_after">
        <observer name="foo_plugin_observer_adminhtml" instance="Acme\ModuleA\Plugin\FooPlugin" />
    </event>
</config>
