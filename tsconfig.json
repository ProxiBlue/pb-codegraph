{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["augmenter/src/**/*", "mcp/**/*", "shared/**/*", "tests/**/*.ts", "scripts/**/*.ts", "bin/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/fixture/**/*", "docs/upstream-pr/**/*"]
}
